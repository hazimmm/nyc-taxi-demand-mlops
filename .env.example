# Copy to .env and adjust. Nothing here is secret by default; never commit a real .env.
# `python -m demand` reads .env from the folder it is started in. A variable set in the
# real environment wins over the same variable in .env.

# Config file to load (default: configs/config.yaml)
# DEMAND_CONFIG_FILE=configs/config.yaml

# Any config value can be overridden: DEMAND_<SECTION>__<KEY>
# DEMAND_MLFLOW__TRACKING_URI=http://localhost:5000
# DEMAND_SERVING__MODEL_URI=models:/taxi-demand@champion

# Grafana admin login used by docker-compose
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change-me
